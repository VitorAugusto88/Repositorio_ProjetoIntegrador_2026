# Copie este arquivo para .env e preencha os valores
# NUNCA envie o .env real para o git

SECRET_KEY=troque-por-uma-chave-secreta-de-50-caracteres-aqui
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de dados
# Para Supabase, prefira usar DATABASE_URL com a string oficial do painel.
# Exemplo:
# DATABASE_URL=postgresql://postgres.[ref]:senha@aws-0-[regiao].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
DB_CONN_MAX_AGE=60
DB_SSLMODE=require

# Fallback local para desenvolvimento sem DATABASE_URL
DB_NAME=clinica_db
DB_USER=clinica_user
DB_PASSWORD=clinica_pass
DB_HOST=localhost
DB_PORT=5432

# CORS - dominios permitidos para o frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
CORS_ALLOW_CREDENTIALS=False
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Autenticacao e throttling
LOGIN_THROTTLE_RATE=5/min
PASSWORD_RESET_THROTTLE_RATE=3/hour
PASSWORD_RESET_CONFIRM_THROTTLE_RATE=10/hour
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_HOURS=12
PASSWORD_RESET_TIMEOUT_SECONDS=900
PASSWORD_MIN_LENGTH=10

# Email SMTP
# Para Gmail, crie uma senha de app na Conta Google e use essa senha aqui.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-de-app-de-16-caracteres
DEFAULT_FROM_EMAIL=ClinicSystem <seu-email@gmail.com>
EMAIL_TIMEOUT=10

# Celery
# Em desenvolvimento, True envia tarefas no mesmo processo.
# Em producao, use False e rode Redis + worker Celery.
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=True

# Hardening HTTP em producao
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
USE_X_FORWARDED_PROTO=False

# Storage S3 ou compativel
USE_S3_STORAGE=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=True
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_MEDIA_LOCATION=media
AWS_S3_CACHE_CONTROL=max-age=86400
