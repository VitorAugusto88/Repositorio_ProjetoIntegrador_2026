# Copie este arquivo para .env e preencha os valores
# NUNCA envie o .env real para o git

SECRET_KEY=troque-por-uma-chave-secreta-de-50-caracteres-aqui
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de dados
# Para Supabase, prefira usar DATABASE_URL com a string oficial do painel.
# Exemplo:
# DATABASE_URL=postgresql://postgres.[ref]:senha@aws-0-[regiao].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
DB_CONN_MAX_AGE=60
DB_SSLMODE=require

# Fallback local para desenvolvimento sem DATABASE_URL
DB_NAME=clinica_db
DB_USER=clinica_user
DB_PASSWORD=clinica_pass
DB_HOST=localhost
DB_PORT=5432

# CORS - dominios permitidos para o frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
