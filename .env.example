# Copie este arquivo para .env e preencha os valores
# NUNCA envie o .env real para o git

SECRET_KEY=troque-por-uma-chave-secreta-de-50-caracteres-aqui
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de dados PostgreSQL
# Cada membro do grupo cria o banco localmente com essas configs
DB_NAME=clinica_db
DB_USER=clinica_user
DB_PASSWORD=clinica_pass
DB_HOST=localhost
DB_PORT=5432

# CORS — domínios permitidos para o frontend (React)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
