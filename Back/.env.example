# Copie este arquivo para .env e preencha os valores.
# NUNCA envie o .env real para o git.
#
# Seções:
#   1. Núcleo (secret/debug/hosts)
#   2. Banco de dados (Postgres — você já tem na nuvem)
#   3. CORS / CSRF (domínio do frontend)
#   4. Auth / throttling
#   5. E-mail (Brevo)
#   6. Redis + Celery (Upstash)
#   7. Storage de mídia (Cloudflare R2)
#   8. Hardening HTTP (produção)

# ─── 1. Núcleo ───────────────────────────────────────────────────────────────
SECRET_KEY=troque-por-uma-chave-secreta-de-50-caracteres-aqui
DEBUG=True
# Em produção (Render), use o domínio do serviço, ex.: clinica-api.onrender.com
# 192.168.x.x é opcional: só precisa se for testar pelo celular na mesma rede.
ALLOWED_HOSTS=127.0.0.1,localhost,192.168.100.131

# ─── 2. Banco de dados ───────────────────────────────────────────────────────
# Prefira DATABASE_URL (Supabase/Neon/Render). Cai no fallback DB_* se vazio.
# Ex.: postgresql://user:senha@host:5432/dbname?sslmode=require
DATABASE_URL=
DB_CONN_MAX_AGE=60
DB_SSLMODE=require

# Fallback local (usado só quando DATABASE_URL está vazio)
DB_NAME=clinica_db
DB_USER=clinica_user
DB_PASSWORD=clinica_pass
DB_HOST=localhost
DB_PORT=5432

# ─── 3. CORS / CSRF ──────────────────────────────────────────────────────────
# Em produção: coloque a URL do frontend no Vercel (https, sem barra final).
# Ex.: https://sistemaclinico-ui.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://127.0.0.1:3000,http://127.0.0.1:8081
CORS_ALLOWED_ORIGIN_REGEXES=
CORS_ALLOW_CREDENTIALS=False
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8081
FRONTEND_URL=http://localhost:8081

# ─── 4. Auth e throttling ────────────────────────────────────────────────────
LOGIN_THROTTLE_RATE=5/min
PASSWORD_RESET_THROTTLE_RATE=3/hour
PASSWORD_RESET_CONFIRM_THROTTLE_RATE=10/hour
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=1
PASSWORD_RESET_TIMEOUT_SECONDS=900
PASSWORD_MIN_LENGTH=10

# ─── 5. E-mail ───────────────────────────────────────────────────────────────
# Em dev, o backend "console" imprime o e-mail no terminal (não envia nada).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=ClinicSystem <no-reply@clinicsystem.local>
EMAIL_TIMEOUT=10
#
# Opção 1 — Gmail via SMTP (bom para testar localmente com e-mails reais):
# ative "Senhas de app" em myaccount.google.com/apppasswords e cole a senha
# gerada em EMAIL_HOST_PASSWORD.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=seu-email@gmail.com
# EMAIL_HOST_PASSWORD=sua-senha-de-app-aqui
# DEFAULT_FROM_EMAIL=seu-email@gmail.com
#
# Opção 2 — Produção (Brevo via API HTTP — django-anymail): use isto no
# Render, que BLOQUEIA as portas de SMTP (25/465/587). SMTP (Gmail) falha com
# "Network is unreachable". Pegue a chave em Brevo → SMTP & API → API Keys e
# cadastre um remetente VERIFICADO como DEFAULT_FROM_EMAIL.
# EMAIL_BACKEND=anymail.backends.brevo.EmailBackend
# BREVO_API_KEY=xkeysib-...
# DEFAULT_FROM_EMAIL=ClinicSystem <remetente-verificado@seudominio.com>

# ─── 6. Redis + Celery (Upstash) ─────────────────────────────────────────────
# Painel Upstash → seu banco Redis → aba "Redis" → copie a connection string TLS.
# Ela começa com rediss:// (com dois "s" = TLS). channels_redis aceita direto.
# Ex.: rediss://default:SENHA@br-xxxx.upstash.io:6379
REDIS_URL=redis://127.0.0.1:6379/0
#
# Celery: por enquanto rodamos as tarefas no próprio processo web (sem worker).
# Deixe True mesmo em produção enquanto não subir um worker separado.
CELERY_TASK_ALWAYS_EAGER=True
#  Só quando for ligar um worker Celery de verdade com Upstash: o broker exige
# o parâmetro ssl_cert_reqs no rediss://. Aí defina explicitamente:
# CELERY_BROKER_URL=rediss://default:SENHA@br-xxxx.upstash.io:6379?ssl_cert_reqs=CERT_REQUIRED
# CELERY_RESULT_BACKEND=rediss://default:SENHA@br-xxxx.upstash.io:6379?ssl_cert_reqs=CERT_REQUIRED

# ─── 6b. Push (Expo Push Service) ────────────────────────────────────────────
# Push mobile (Android/iOS) via Expo — não usa firebase-admin, é só um POST HTTP.
# Deixe True para ligar o envio real; False mantém as notificações PUSH pendentes.
PUSH_ENABLED=False
# Opcional: token de acesso do Expo (expo.dev → Account → Access Tokens). Vazio
# = envio anônimo (aceito). Recomendado preencher em produção.
EXPO_ACCESS_TOKEN=

# ─── 7. Storage de mídia (Cloudflare R2) ─────────────────────────────────────
# Cloudflare → R2 → crie um bucket e um "R2 API Token" (credenciais S3).
# Region é sempre "auto" no R2. O ENDPOINT_URL é o da conta (upload).
# Para o navegador conseguir abrir imagem/áudio, o bucket precisa de leitura
# pública: ative o subdomínio r2.dev (ou um domínio próprio) e ponha esse host
# em AWS_S3_CUSTOM_DOMAIN + AWS_QUERYSTRING_AUTH=False (URLs sem assinatura).
USE_S3_STORAGE=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=clinica-media
AWS_S3_REGION_NAME=auto
# Ex.: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_S3_ENDPOINT_URL=
# Host público de leitura, SEM https:// e SEM barra final.
# Ex.: pub-xxxxxxxx.r2.dev  (ou o seu domínio: midia.sua-clinica.com)
AWS_S3_CUSTOM_DOMAIN=
# Bucket público → False (links não expiram). Bucket privado → True (URLs assinadas).
AWS_QUERYSTRING_AUTH=False
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_MEDIA_LOCATION=media
AWS_S3_CACHE_CONTROL=max-age=86400

# ─── 8. Hardening HTTP (produção) ────────────────────────────────────────────
# Em dev deixe tudo desligado. Na Render (HTTPS + proxy), ligue os de baixo.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# Render encerra o TLS num proxy — ligue para o Django reconhecer HTTPS.
USE_X_FORWARDED_PROTO=False
